# Banco (bun run db:up sobe o Postgres com pgvector na porta 5434)
DATABASE_URL=postgres://rag:rag@localhost:5434/rag
# Só para os testes de integração do pgvector
TEST_DATABASE_URL=postgres://rag:rag@localhost:5434/rag_test

# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Embeddings: gemini ou ollama
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
# Trocar de modelo ou de dimensão depois exige recriar o banco (bun run db:reset).
EMBEDDING_DIMENSIONS=768

# LLM que escreve a resposta: gemini ou ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# Só se algum provedor for ollama (ex.: EMBEDDING_MODEL=nomic-embed-text, LLM_MODEL=llama3.2)
OLLAMA_URL=http://localhost:11434

# Recuperação
RAG_TOP_K=5
RAG_CANDIDATES=20
# Depende do modelo de embedding: calibre com bun run rag eval
RAG_MIN_SIMILARITY=0.4
RAG_HYBRID=true

# Chunking (em caracteres, ~4 por token em português)
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Configuração de full-text do Postgres (stemming e stopwords)
FTS_LANGUAGE=portuguese

COLLECTIONS_DIR=collections
API_PORT=3000
